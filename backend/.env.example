# Copy this file to .env and fill in your real values.
# The real .env is gitignored and must never be committed.

# Required: your Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: which Gemini model to use. Defaults to gemini-flash-latest if unset.
# GEMINI_MODEL=gemini-flash-latest

# Optional production settings:
# API_KEY: if set, clients must send it as the X-API-Key header (auth). Unset = off.
# API_KEY=change-me
# RATE_LIMIT_PER_MINUTE: max requests per client IP per minute (0 = off). Default 30.
# RATE_LIMIT_PER_MINUTE=30
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. Default INFO.
# LOG_LEVEL=INFO
# DB_PATH: SQLite file path. Default chatbot.db
# DB_PATH=chatbot.db
